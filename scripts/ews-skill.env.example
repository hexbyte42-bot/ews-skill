MAIL_PROTOCOL=ews

# Shared (EWS + Graph)
EWS_SYNC_FOLDERS=inbox,sentitems
EWS_SYNC_INTERVAL_SECONDS=30
EWS_LOG_LEVEL=info
EWS_RETRY_MAX_ATTEMPTS=5
EWS_RETRY_BASE_MS=500
EWS_RETRY_MAX_BACKOFF_MS=10000

# EWS mode (on-prem Exchange)
EWS_EMAIL=user@company.com
# usually same as EWS_EMAIL, set explicitly if login name differs
EWS_USERNAME=user@company.com
EWS_PASSWORD=change-me
EWS_AUTH_MODE=ntlm
EWS_AUTODISCOVER=true
# EWS_URL=https://mail.company.com/EWS/Exchange.asmx
EWS_SYNC_LOOKBACK_DAYS=7

# Graph mode (Microsoft 365 delegated auth)
# MAIL_PROTOCOL=graph
# GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GRAPH_SYNC_MAX_PER_FOLDER=200
# After daemon starts in graph mode, run: ews_skillctl login
# EWS_SYNC_INTERVAL_SECONDS=0 disables Graph background polling
